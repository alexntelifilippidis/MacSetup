# shellcheck shell=bash
# ─────────────────────────────────────────────────────────────────────────────
# Personal secrets — copied to ~/.secrets.zsh by setup.sh (chmod 600).
# THIS TEMPLATE IS COMMITTED. The real ~/.secrets.zsh is gitignored.
# Never commit real tokens. Rotate any token that lands in git history.
# ─────────────────────────────────────────────────────────────────────────────

# GitLab PAT — used by `uv` for the private package index and by notebook-check.
# Scopes: read_api, read_repository (least privilege).
# Create one at: https://gitlab.com/-/user_settings/personal_access_tokens
export UV_INDEX_GITLAB_USERNAME='your.username'
export UV_INDEX_GITLAB_PASSWORD='glpat-REPLACE_ME'
export GITLAB_TOKEN='glpat-REPLACE_ME'
