# Secrets — real values live in $HOME/.secrets.zsh (chmod 600), never in git.
# Only the .template file is committed.
src/dotfiles/zsh/.secrets.zsh
.secrets.zsh

# Theme selection — machine-specific, chosen interactively by `make zsh-setup`.
# Only the .template file (default: batman) is committed.
src/dotfiles/zsh/.theme
*.secret
.env
.env.*
!.env.template

# Claude local overrides — machine-specific, never committed
src/dotfiles/claude/settings.local.json
